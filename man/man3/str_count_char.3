.TH STR_COUNT_CHAR 3 "September 2026" "libmyutils" "Library Functions Manual"
.SH NAME
str_count_char \- count occurrences of a character in a string
.SH SYNOPSIS
.nf
.B #include "mystrfunctions.h"
.sp
.BI "int str_count_char(const char *" str ", char " c );
.fi
.SH DESCRIPTION
The
.B str_count_char()
function counts how many times the character
.I c
appears in
.IR str .
.SH RETURN VALUE
Returns the number of occurrences of
.I c
in
.IR str .
.SH EXAMPLE
.nf
int n = str_count_char("hello", 'l');
/* n is 2 */
.fi
.SH AUTHOR
Haseeb
